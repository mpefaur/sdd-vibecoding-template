{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(rtk:*)"
    ],
    "ask": [
      "Bash(docker build:*)"
    ]
  },
  "env": {
    "LINT_CMD": "npm run lint --silent",
    "TEST_CMD": "npm test --silent",
    "BUILD_CMD": "npm run build"
  },
  "hooks": {
    "Stop": []
  }
}
